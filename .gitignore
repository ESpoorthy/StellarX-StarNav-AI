# ─────────────────────────────────────────────
# StellarX-StarNav-AI — .gitignore
# Python-oriented, research-grade project
# ─────────────────────────────────────────────

# ----- Python bytecode -----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/

# ----- Environment variables / secrets -----
.env
.env.*

# ----- Jupyter / IPython -----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- Test & lint caches -----
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ----- IDE / editor -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Data directories (large / generated files) -----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ----- Trained model artifacts -----
models/*.pt
models/*.pth
models/*.onnx
models/*.bin
models/*.pkl
!models/.gitkeep

# ----- Logs -----
*.log
logs/

# ----- macOS metadata -----
.DS_Store
.AppleDouble
.LSOverride

# ----- Distribution / packaging -----
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ----- Temporary files -----
tmp/
temp/
*.tmp
*.bak
